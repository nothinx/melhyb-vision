# Semua pengaturan bisa ditimpa lewat variabel lingkungan berawalan SIGMA_.
# Salin berkas ini menjadi backend/.env lalu sesuaikan.

# SIGMA_DATABASE_URL=sqlite:///./sigma.db
# SIGMA_DATABASE_URL=postgresql+psycopg://sigma:rahasia@localhost:5432/sigma

# --- gerbang kualitas citra ---
# SIGMA_MIN_SIDE_PX=640
# SIGMA_MIN_SHARPNESS=35
# SIGMA_MIN_SEEDS_DETECTED=15

# --- syarat kalibrasi ---
# Naikkan setelah data bertambah; jangan pernah diturunkan untuk mengejar
# supaya angka cepat muncul.
# SIGMA_MIN_CALIBRATION_SAMPLES=30
# SIGMA_MIN_CALIBRATION_R2=0.30
