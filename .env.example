# Semua pengaturan bisa ditimpa lewat variabel lingkungan berawalan MELHYB_.
# Salin berkas ini menjadi backend/.env lalu sesuaikan.

# MELHYB_DATABASE_URL=sqlite:///./melhyb.db
# MELHYB_DATABASE_URL=postgresql+psycopg://melhyb:rahasia@localhost:5432/melhyb

# --- gerbang kualitas citra ---
# MELHYB_MIN_SIDE_PX=640
# MELHYB_MIN_SHARPNESS=35
# MELHYB_MIN_SEEDS_DETECTED=15

# --- syarat kalibrasi ---
# Naikkan setelah data bertambah; jangan pernah diturunkan untuk mengejar
# supaya angka cepat muncul.
# MELHYB_MIN_CALIBRATION_SAMPLES=30
# MELHYB_MIN_CALIBRATION_R2=0.30
